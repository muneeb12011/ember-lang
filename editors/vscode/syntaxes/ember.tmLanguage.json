{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Ember",
  "scopeName": "source.ember",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#chars" },
    { "include": "#numbers" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#calls" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.ember", "match": "//.*$" },
        { "name": "comment.block.ember", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "escapes": {
      "name": "constant.character.escape.ember",
      "match": "\\\\(x[0-9A-Fa-f]{2}|[ntr0\\\\\"'])"
    },
    "strings": {
      "name": "string.quoted.double.ember",
      "begin": "\"",
      "end": "\"",
      "patterns": [ { "include": "#escapes" } ]
    },
    "chars": {
      "name": "string.quoted.single.ember",
      "match": "'(\\\\(x[0-9A-Fa-f]{2}|[ntr0\\\\\"'])|[^'\\\\])'"
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.float.ember", "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9]+)?\\b" },
        { "name": "constant.numeric.hex.ember", "match": "\\b0x[0-9A-Fa-f_]+\\b" },
        { "name": "constant.numeric.binary.ember", "match": "\\b0b[01_]+\\b" },
        { "name": "constant.numeric.integer.ember", "match": "\\b[0-9][0-9_]*\\b" }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": { "1": { "name": "storage.type.function.ember" }, "2": { "name": "entity.name.function.ember" } }
        },
        {
          "match": "\\b(struct|enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": { "1": { "name": "storage.type.ember" }, "2": { "name": "entity.name.type.ember" } }
        },
        {
          "match": "\\b(as)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": { "1": { "name": "keyword.control.import.ember" }, "2": { "name": "entity.name.namespace.ember" } }
        }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.ember", "match": "\\b(if|else|while|for|in|return|break|continue|match)\\b" },
        { "name": "keyword.control.import.ember", "match": "\\b(import|pub)\\b" },
        { "name": "storage.type.ember", "match": "\\b(fn|let|const|struct|enum)\\b" },
        { "name": "storage.modifier.ember", "match": "\\bmut\\b" },
        { "name": "keyword.operator.new.ember", "match": "\\bnew\\b" },
        { "name": "constant.language.ember", "match": "\\b(true|false|null)\\b" },
        { "name": "variable.language.ember", "match": "\\b_\\b" }
      ]
    },
    "types": {
      "patterns": [
        { "name": "support.type.primitive.ember", "match": "\\b(int|float|bool|str|byte)\\b(?!\\s*\\()" },
        { "name": "entity.name.type.ember", "match": "\\b[A-Z][A-Za-z0-9_]*\\b" }
      ]
    },
    "calls": {
      "patterns": [
        {
          "name": "support.function.builtin.ember",
          "match": "\\b(print|put|len|str|int|float|chr|substr|parse_int|str_from_bytes|read_int|read_line|at_eof|sqrt|sin|cos|tan|atan|atan2|exp|log|pow|floor|ceil|read_file|write_file|append_file|file_exists|arg_count|arg|env|has_env|exit|clock_ns|panic|assert)(?=\\s*\\()"
        },
        { "name": "entity.name.function.call.ember", "match": "\\b[a-z_][A-Za-z0-9_]*(?=\\s*(<[^<>()]*>)?\\s*\\()" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.arrow.ember", "match": "->|=>" },
        { "name": "keyword.operator.range.ember", "match": "\\.\\." },
        { "name": "keyword.operator.logical.ember", "match": "&&|\\|\\||!(?!=)" },
        { "name": "keyword.operator.comparison.ember", "match": "==|!=|<=|>=" },
        { "name": "keyword.operator.assignment.ember", "match": "(\\+|-|\\*|/|%|&|\\||\\^|<<|>>)?=" },
        { "name": "keyword.operator.arithmetic.ember", "match": "<<|>>|[+\\-*/%&|^~<>]" }
      ]
    }
  }
}
